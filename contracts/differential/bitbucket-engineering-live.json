{
  "version":1,"name":"bitbucket-engineering-live","safety":{"disposableOnly":true},
  "variables":{"real_workspace":"nikiniks2005","real_repo":"mcp_test","workspace":"acme","repo":"product"},
  "steps":[
    {"id":"resolve-main","real":{"method":"GET","path":"/repositories/${real_workspace}/${real_repo}/refs/branches/main"},"replica":{"operation":"create_commit","arguments":{"workspace":"${workspace}","repo_slug":"${repo}","branch":"main","message":"Differential base ${run_id}","files":{"README.md":"base\n"}}},"expect":{"real_status":200},"capture":{"real":{"base_hash":"$.target.hash"},"replica":{"base_hash":"$.hash"}},"compare":{"body":false}},
    {"id":"create-feature-commit","real":{"method":"POST","path":"/repositories/${real_workspace}/${real_repo}/src","multipart":{"fields":{"branch":"diff-${run_id}","parents":"${base_hash}","message":"Differential feature ${run_id}"},"files":{"differential-${run_id}.txt":"feature\n","bitbucket-pipelines.yml":"pipelines:\n  default:\n    - step:\n        script:\n          - echo ok\n"}}},"replica":{"operation":"create_commit","arguments":{"workspace":"${workspace}","repo_slug":"${repo}","branch":"diff-${run_id}","message":"Differential feature ${run_id}","parents":["${base_hash}"],"files":{"differential.txt":"feature\n","bitbucket-pipelines.yml":"pipelines:\n  default:\n    - step:\n        script:\n          - echo ok\n"}}},"expect":{"real_status":201},"capture":{"replica":{"feature_hash":"$.hash"}},"compare":{"body":false}},
    {"id":"resolve-feature","real":{"method":"GET","path":"/repositories/${real_workspace}/${real_repo}/refs/branches/diff-${run_id}"},"replica":{"operation":"get_commit","arguments":{"workspace":"${workspace}","repo_slug":"${repo}","commit":"${feature_hash}"}},"expect":{"real_status":200},"capture":{"real":{"feature_hash":"$.target.hash"},"replica":{"feature_hash":"$.hash"}},"compare":{"body":false}},
    {"id":"create-pull-request","real":{"method":"POST","path":"/repositories/${real_workspace}/${real_repo}/pullrequests","json":{"title":"Differential PR ${run_id}","description":"Bitbucket engineering differential","source":{"branch":{"name":"diff-${run_id}"}},"destination":{"branch":{"name":"main"}}}},"replica":{"operation":"create_pull_request","arguments":{"workspace":"${workspace}","repo_slug":"${repo}","title":"Differential PR ${run_id}","description":"Bitbucket engineering differential","source_branch":"diff-${run_id}","destination_branch":"main"}},"expect":{"real_status":201},"capture":{"real":{"pr_id":"$.id"},"replica":{"pr_id":"$.id"}},"compare":{"ignore_shape_fields":["username"],"semantic_paths":["$.title","$.description","$.state","$.source.branch.name","$.destination.branch.name"]}},
    {"id":"get-pr-diff","real":{"method":"GET","path":"/repositories/${real_workspace}/${real_repo}/pullrequests/${pr_id}/diff"},"replica":{"operation":"get_pull_request_diff","arguments":{"workspace":"${workspace}","repo_slug":"${repo}","pull_request_id":"${pr_id}"}},"expect":{"real_status":[200,302]},"compare":{"body":false}},
    {"id":"create-review-comment","real":{"method":"POST","path":"/repositories/${real_workspace}/${real_repo}/pullrequests/${pr_id}/comments","json":{"content":{"raw":"Differential review ${run_id}"}}},"replica":{"operation":"create_pull_request_comment","arguments":{"workspace":"${workspace}","repo_slug":"${repo}","pull_request_id":"${pr_id}","content":"Differential review ${run_id}"}},"expect":{"real_status":201},"compare":{"ignore_shape_fields":["username"],"semantic_paths":["$.content.raw"]}},
    {"id":"create-commit-status","real":{"method":"POST","path":"/repositories/${real_workspace}/${real_repo}/commit/${feature_hash}/statuses/build","json":{"key":"MCP-DIFF","state":"SUCCESSFUL","name":"MCP differential","url":"https://example.invalid/mcp-differential","description":"Differential status"}},"replica":{"operation":"create_commit_status","arguments":{"workspace":"${workspace}","repo_slug":"${repo}","commit":"${feature_hash}","key":"MCP-DIFF","state":"SUCCESSFUL","name":"MCP differential","url":"https://example.invalid/mcp-differential","description":"Differential status"}},"expect":{"real_status":201},"compare":{"semantic_paths":["$.key","$.state","$.name","$.description"]}},
    {"id":"decline-real-pr","real":{"method":"POST","path":"/repositories/${real_workspace}/${real_repo}/pullrequests/${pr_id}/decline"},"replica":{"operation":"get_pull_request","arguments":{"workspace":"${workspace}","repo_slug":"${repo}","pull_request_id":"${pr_id}"}},"expect":{"real_status":200},"compare":{"body":false}},
    {"id":"delete-feature-branch","real":{"method":"DELETE","path":"/repositories/${real_workspace}/${real_repo}/refs/branches/diff-${run_id}"},"replica":{"operation":"delete_branch","arguments":{"workspace":"${workspace}","repo_slug":"${repo}","name":"diff-${run_id}"}},"expect":{"real_status":204},"compare":{"body":false}}
  ]
}
