{
  "version":1,"name":"jira-core-live","safety":{"disposableOnly":true},
  "steps":[
    {"id":"create-issue","real":{"method":"POST","path":"/rest/api/3/issue","json":{"fields":{"project":{"key":"SCRUM"},"summary":"Differential issue ${run_id}","issuetype":{"id":"10003"},"labels":["mcp-differential"]}}},"replica":{"operation":"create_issue","arguments":{"fields":{"project":{"key":"PROD"},"summary":"Differential issue ${run_id}","issuetype":{"id":"10003"},"labels":["mcp-differential"]}}},"expect":{"real_status":201},"poll":{"attempts":4,"interval_seconds":2},"capture":{"real":{"issue_key":"$.key"},"replica":{"issue_key":"$.key"}},"compare":{"body":false}},
    {"id":"get-issue","real":{"method":"GET","path":"/rest/api/3/issue/${issue_key}","query":{"fields":"summary,status,labels,issuetype"}},"replica":{"operation":"get_issue","arguments":{"issue_id_or_key":"${issue_key}"}},"expect":{"real_status":200},"compare":{"shape":false,"semantic_paths":["$.fields.summary","$.fields.labels"]}},
    {"id":"add-comment","real":{"method":"POST","path":"/rest/api/3/issue/${issue_key}/comment","json":{"body":{"type":"doc","version":1,"content":[{"type":"paragraph","content":[{"type":"text","text":"Differential comment ${run_id}"}]}]}}},"replica":{"operation":"add_comment","arguments":{"issue_id_or_key":"${issue_key}","body":{"type":"doc","version":1,"content":[{"type":"paragraph","content":[{"type":"text","text":"Differential comment ${run_id}"}]}]}}},"expect":{"real_status":201},"poll":{"attempts":4,"interval_seconds":2},"capture":{"real":{"comment_id":"$.id"},"replica":{"comment_id":"$.id"}},"compare":{"real_body":"$.body","replica_body":"$.body"}},
    {"id":"update-issue","real":{"method":"PUT","path":"/rest/api/3/issue/${issue_key}","json":{"fields":{"summary":"Differential issue updated ${run_id}"}}},"replica":{"operation":"update_issue","arguments":{"issue_id_or_key":"${issue_key}","fields":{"summary":"Differential issue updated ${run_id}"}}},"expect":{"real_status":204},"compare":{"body":false}},
    {"id":"verify-update","real":{"method":"GET","path":"/rest/api/3/issue/${issue_key}","query":{"fields":"summary,status,labels"}},"replica":{"operation":"get_issue","arguments":{"issue_id_or_key":"${issue_key}"}},"expect":{"real_status":200},"compare":{"shape":false,"semantic_paths":["$.fields.summary","$.fields.labels"]}}
  ]
}
