{
  "version":1,"name":"youtrack-core-live","safety":{"disposableOnly":true},
  "steps":[
    {"id":"create-issue","real":{"method":"POST","path":"/api/issues","query":{"fields":"id,idReadable,summary,description"},"json":{"project":{"id":"0-0"},"summary":"Differential issue ${run_id}","description":"YouTrack live differential"}},"replica":{"operation":"create_issue","arguments":{"project_id":"PROD","summary":"Differential issue ${run_id}","description":"YouTrack live differential"}},"expect":{"real_status":200},"capture":{"real":{"issue_id":"$.id","issue_readable":"$.idReadable"},"replica":{"issue_id":"$.id","issue_readable":"$.idReadable"}},"compare":{"shape":false,"semantic_paths":["$.summary","$.description"]}},
    {"id":"get-issue","real":{"method":"GET","path":"/api/issues/${issue_id}","query":{"fields":"id,idReadable,summary,description,resolved"}},"replica":{"operation":"get_issue","arguments":{"issue_id":"${issue_id}"}},"expect":{"real_status":200},"compare":{"shape":false,"semantic_paths":["$.summary","$.description"]}},
    {"id":"create-comment","real":{"method":"POST","path":"/api/issues/${issue_id}/comments","query":{"fields":"id,text"},"json":{"text":"Differential comment ${run_id}"}},"replica":{"operation":"create_comment","arguments":{"issue_id":"${issue_id}","text":"Differential comment ${run_id}"}},"expect":{"real_status":200},"compare":{"shape":false,"semantic_paths":["$.text"]}},
    {"id":"update-issue","real":{"method":"POST","path":"/api/issues/${issue_id}","query":{"fields":"id,idReadable,summary,description"},"json":{"summary":"Differential issue updated ${run_id}"}},"replica":{"operation":"update_issue","arguments":{"issue_id":"${issue_id}","summary":"Differential issue updated ${run_id}"}},"expect":{"real_status":200},"compare":{"shape":false,"semantic_paths":["$.summary"]}},
    {"id":"apply-command","real":{"method":"POST","path":"/api/commands","query":{"fields":"query"},"json":{"query":"State Done","issues":[{"idReadable":"${issue_readable}"}]}},"replica":{"operation":"apply_command","arguments":{"issue_id":"${issue_readable}","query":"State Done"}},"expect":{"real_status":200},"compare":{"body":false}},
    {"id":"verify-update","real":{"method":"GET","path":"/api/issues/${issue_id}","query":{"fields":"id,idReadable,summary,resolved"}},"replica":{"operation":"get_issue","arguments":{"issue_id":"${issue_id}"}},"expect":{"real_status":200},"compare":{"shape":false,"semantic_paths":["$.summary"]}}
  ]
}
