{
  "version":1,"name":"github-engineering-live","safety":{"disposableOnly":true},
  "variables":{"real_owner":"Kreativshikkk","real_repo":"mcp-system-test","owner":"acme","repo":"product"},
  "steps":[
    {"id":"resolve-base","real":{"method":"GET","path":"/repos/${real_owner}/${real_repo}/git/ref/heads/main"},"replica":{"operation":"create_commit","arguments":{"owner":"${owner}","repository":"${repo}","message":"Differential base ${run_id}","author":"engineer","files":{"README.md":"base\n"}}},"expect":{"real_status":200},"capture":{"real":{"base_sha":"$.object.sha"},"replica":{"base_sha":"$.sha"}},"compare":{"body":false}},
    {"id":"create-real-feature-and-local-main","real":{"method":"POST","path":"/repos/${real_owner}/${real_repo}/git/refs","json":{"ref":"refs/heads/diff-${run_id}","sha":"${base_sha}"}},"replica":{"operation":"create_branch","arguments":{"owner":"${owner}","repository":"${repo}","name":"main","head_sha":"${base_sha}"}},"expect":{"real_status":201},"compare":{"body":false}},
    {"id":"commit-workflow","real":{"method":"PUT","path":"/repos/${real_owner}/${real_repo}/contents/.github/workflows/differential-${run_id}.yml","json":{"message":"Differential workflow ${run_id}","content":"bmFtZTogRGlmZmVyZW50aWFsIENJCm9uOiBbcHVzaF0Kam9iczoKICB0ZXN0OgogICAgcnVucy1vbjogdWJ1bnR1LWxhdGVzdAogICAgc3RlcHM6CiAgICAgIC0gcnVuOiBlY2hvIG9rCg==","branch":"diff-${run_id}"}},"replica":{"operation":"create_commit","arguments":{"owner":"${owner}","repository":"${repo}","message":"Differential workflow ${run_id}","author":"engineer","parent_shas":["${base_sha}"],"files":{".github/workflows/differential.yml":"name: Differential CI\non: [push]\njobs:\n  test:\n    runs-on: ubuntu-latest\n    steps:\n      - run: echo ok\n"}}},"expect":{"real_status":201},"capture":{"real":{"feature_sha":"$.commit.sha"},"replica":{"feature_sha":"$.sha"}},"compare":{"body":false}},
    {"id":"materialize-local-feature","real":{"method":"GET","path":"/repos/${real_owner}/${real_repo}/git/ref/heads/diff-${run_id}"},"replica":{"operation":"create_branch","arguments":{"owner":"${owner}","repository":"${repo}","name":"diff-${run_id}","head_sha":"${feature_sha}"}},"expect":{"real_status":200},"compare":{"body":false}},
    {"id":"create-pull-request","real":{"method":"POST","path":"/repos/${real_owner}/${real_repo}/pulls","json":{"title":"Differential PR ${run_id}","body":"GitHub engineering differential","head":"diff-${run_id}","base":"main"}},"replica":{"operation":"create_pull_request","arguments":{"owner":"${owner}","repository":"${repo}","title":"Differential PR ${run_id}","body":"GitHub engineering differential","head":"diff-${run_id}","base":"main"}},"expect":{"real_status":201},"capture":{"real":{"pull_number":"$.number"},"replica":{"pull_number":"$.number"}},"compare":{"ignore_shape_fields":["name","email"],"semantic_paths":["$.title","$.body","$.state","$.draft"]}},
    {"id":"create-review","real":{"method":"POST","path":"/repos/${real_owner}/${real_repo}/pulls/${pull_number}/reviews","json":{"event":"COMMENT","body":"Differential review ${run_id}"}},"replica":{"operation":"create_review","arguments":{"owner":"${owner}","repository":"${repo}","pull_number":"${pull_number}","event":"COMMENT","body":"Differential review ${run_id}"}},"expect":{"real_status":200},"compare":{"ignore_shape_fields":["name","email"],"semantic_paths":["$.body","$.state"]}},
    {"id":"discover-actions-run","real":{"method":"GET","path":"/repos/${real_owner}/${real_repo}/actions/runs","query":{"branch":"diff-${run_id}","event":"push","per_page":1}},"replica":{"operation":"create_workflow_run","arguments":{"owner":"${owner}","repository":"${repo}","name":"Differential CI","event":"push","head_branch":"diff-${run_id}","status":"in_progress"}},"expect":{"real_status":200},"poll":{"attempts":12,"interval_seconds":5},"capture":{"real":{"run_id":"$.workflow_runs.0.id"},"replica":{"run_id":"$.id"}},"compare":{"body":false}},
    {"id":"discover-actions-job","real":{"method":"GET","path":"/repos/${real_owner}/${real_repo}/actions/runs/${run_id}/jobs"},"replica":{"operation":"create_workflow_job","arguments":{"owner":"${owner}","repository":"${repo}","run_id":"${run_id}","name":"test","status":"in_progress","log":"echo ok\nok\n"}},"expect":{"real_status":200},"poll":{"attempts":12,"interval_seconds":5},"capture":{"real":{"job_id":"$.jobs.0.id"},"replica":{"job_id":"$.id"}},"compare":{"body":false}},
    {"id":"get-actions-job","real":{"method":"GET","path":"/repos/${real_owner}/${real_repo}/actions/jobs/${job_id}"},"replica":{"operation":"get_workflow_job","arguments":{"owner":"${owner}","repository":"${repo}","job_id":"${job_id}"}},"expect":{"real_status":200},"compare":{"semantic_paths":["$.name"]}},
    {"id":"close-pull-request","real":{"method":"PATCH","path":"/repos/${real_owner}/${real_repo}/pulls/${pull_number}","json":{"state":"closed"}},"replica":{"operation":"update_pull_request","arguments":{"owner":"${owner}","repository":"${repo}","pull_number":"${pull_number}","state":"closed"}},"expect":{"real_status":200},"compare":{"ignore_shape_fields":["name","email"],"semantic_paths":["$.title","$.state"]}},
    {"id":"delete-real-feature","real":{"method":"DELETE","path":"/repos/${real_owner}/${real_repo}/git/refs/heads/diff-${run_id}"},"replica":{"operation":"list_branches","arguments":{"owner":"${owner}","repository":"${repo}"}},"expect":{"real_status":[204,422]},"compare":{"body":false}}
  ]
}
